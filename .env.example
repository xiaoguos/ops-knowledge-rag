# Copy to .env on the deployment host; never commit secrets.
# URL-encode special characters in DATABASE_URL passwords.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_SECRET
DATABASE_URL=postgresql+psycopg://app:REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_SECRET@postgres:5432/app
APP_ENV=production
CORS_ORIGINS=https://xiaoguos.github.io
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Public DNS name pointing to your server. Caddy obtains TLS automatically.
PUBLIC_HOST=api.example.com
