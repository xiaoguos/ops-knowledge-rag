# No credentials are needed for the offline, extractive baseline.
RAG_DATA_DIR=data/runtime
RAG_EMBEDDING=hash
# fastembed enables real local semantic embeddings; install .[semantic].
RAG_EMBED_MODEL=intfloat/multilingual-e5-small
RAG_GENERATION=extractive
# openai-compatible endpoint for Qwen / other compatible services.
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=
MODEL_NAME=qwen3:8b
EMBEDDING_MODEL=text-embedding-v3
COHERE_API_KEY=
COHERE_MODEL=rerank-multilingual-v3.0
API_TOKEN=
CORS_ORIGINS=https://xiaoguos.github.io

