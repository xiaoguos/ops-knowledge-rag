# Copy to .env on the deployment host; never commit secrets.
# URL-encode special characters in DATABASE_URL passwords.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_SECRET
DATABASE_URL=postgresql+psycopg://app:REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_SECRET@postgres:5432/app
APP_ENV=production
CORS_ORIGINS=https://xiaoguos.github.io
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# DeepSeek JSON workflows can use disabled; blank omits provider-specific field.
MODEL_THINKING=
# Optional retrieval-only rewriting. Original query remains a retrieval route.
RAG_QUERY_REWRITE=0
# Local CPU OCR model cache; images are not sent to an external service by default.
OCR_MODEL_DIR=/app/model-cache/ocr
# Optional image-capable endpoint. Enabling this sends scanned pages to that provider.
# Use only when your document/data policy permits it; review is still required.
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_THINKING=
# Public DNS name pointing to your server. Caddy obtains TLS automatically.
PUBLIC_HOST=api.example.com
